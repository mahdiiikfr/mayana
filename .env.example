# --- TELEGRAM BOT CONFIGURATION ---
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=123456789  # Replace with the main admin's Telegram User ID

# --- DATABASE CONFIGURATION ---
DB_PATH=db/bot_database.db

# --- OPENSTACK CONFIGURATION ---
# Path to openrc.sh authentication script
OPENRC_PATH=api/openrc.sh

# --- APP CONFIGURATION ---
# Default language of the bot: 'fa' or 'en'
DEFAULT_LOCALE=fa
